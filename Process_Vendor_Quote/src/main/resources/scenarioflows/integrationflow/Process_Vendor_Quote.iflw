                </ifl:property>
                <ifl:property>
                    <key>wrapContent</key>
                    <value>{
  "systemInstruction": {
    "parts": [
      {
        "text": "You are a specialized procurement extraction agent. Parse the vendor quotation document and extract all quoted line items. Output strictly a JSON object with this structure: { \"items\": [ { \"itemNumber\": 10, \"materialNumber\": \"string\", \"description\": \"string\", \"quantity\": 0.0, \"unitPrice\": 0.0, \"leadTimeDays\": 0, \"confidence\": 0.0 } ] }. For each line item, evaluate how clearly the price and quantity were stated and assign a confidence score between 0.00 and 1.00."
      }
    ]
  },
  "contents": [
    {
      "role": "user",
      "parts": [
        {
          "text": "${property.extractedDocText}"
        }
      ]
    }
  ],
  "generationConfig": {
    "temperature": 0.0,
    "responseMimeType": "application/json"
  }
}</value>
